---
import Layout from '../layouts/Layout.astro';
import ImageToPdfConverter from '../components/converter/ImageToPdfConverter';
import CategorySection from '../components/CategorySection.astro';
import PrivacyBanner from '../components/PrivacyBanner.astro';
import SeoContent from '../components/SeoContent.astro';
import FAQSection from '../components/FAQSection.astro';
import CompanyHubSection from '../components/CompanyHubSection.astro';
import ToolCard from '../components/ToolCard.astro';
import { CATEGORIES, POPULAR_TOOLS } from '../data/tools';

const pageTitle = "Image To Pdf – Free Online Image to PDF Converter & Maker";
const pageDescription = "Convert image to PDF free online with our fast image to pdf converter. Turn JPG to PDF, resize PDF to 100KB or 200KB, merge PDF, & convert PDF to JPG 100% private in your browser.";
const pageKeywords = "image to pdf, image to pdf converter, convert image to pdf, how to convert image to pdf, pdf to jpg, image to pdf converter free, image to pdf 200kb, image to pdf maker, image to pdf 100kb, jpg to pdf, merge pdf, pdf resize";

const homeSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Image To Pdf",
    "alternateName": [
      "Image to PDF Converter",
      "Image to PDF Maker",
      "Online Image to PDF Converter Free",
      "JPG to PDF Converter"
    ],
    "url": "https://onlineimagetopdf.com",
    "applicationCategory": "MultimediaApplication",
    "operatingSystem": "All",
    "browserRequirements": "Requires JavaScript. Requires HTML5.",
    "description": pageDescription,
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Convert image to PDF",
      "JPG to PDF conversion",
      "Image to PDF 100KB preset",
      "Image to PDF 200KB preset",
      "PDF resize and compression",
      "Merge PDF documents",
      "PDF to JPG converter",
      "100% client-side WebAssembly conversion"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Convert Image to PDF Online for Free",
    "description": "Step-by-step tutorial on how to convert image to PDF in seconds with custom layout, 100KB/200KB size presets, and complete client-side privacy.",
    "totalTime": "PT30S",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Upload or Drag Images",
        "text": "Drag and drop your JPG, PNG, WebP, or HEIC image files into the converter area.",
        "url": "https://onlineimagetopdf.com/#converter-section"
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Customize Layout & Margins",
        "text": "Choose page orientation, standard paper size (A4, Letter, Fit to Image), and margin options.",
        "url": "https://onlineimagetopdf.com/#converter-section"
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Select Target File Size (100KB / 200KB / Custom)",
        "text": "Choose your target size preset such as 100KB or 200KB to automatically resize and compress your PDF for portal uploads.",
        "url": "https://onlineimagetopdf.com/#converter-section"
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Convert and Download PDF",
        "text": "Click 'Convert to PDF' to generate and download your finalized PDF immediately in your browser.",
        "url": "https://onlineimagetopdf.com/#converter-section"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Image To Pdf",
    "url": "https://onlineimagetopdf.com",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://onlineimagetopdf.com/tools/{search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonicalUrl="https://onlineimagetopdf.com"
  image="https://onlineimagetopdf.com/og-image.png"
  schema={homeSchemas}
>
  <!-- Hero Section -->
  <section class="relative pt-8 pb-14 sm:pt-14 sm:pb-20 overflow-hidden border-b border-neutral-300/80 dark:border-neutral-800 bg-radial from-neutral-200/50 via-transparent to-transparent dark:from-neutral-900/30">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <!-- Top Pill Badge -->
      <div class="flex justify-center mb-5 sm:mb-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 shadow-2xs text-xs font-mono text-neutral-900 dark:text-neutral-100 font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="font-bold text-neutral-950 dark:text-neutral-100">100% Free Client-Side Engine</span>
          <span class="text-neutral-400 dark:text-neutral-600">•</span>
          <span class="text-emerald-800 dark:text-emerald-400 font-bold">Zero Server Uploads</span>
        </div>
      </div>

      <!-- Headline -->
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-neutral-950 dark:text-white leading-[1.12]">
          Image To Pdf Converter.<br class="hidden sm:inline"/>
          <span class="vercel-blue-gradient">Fast, Private &amp; 100% Free.</span>
        </h1>
        <p class="mt-4 text-sm sm:text-base md:text-lg text-neutral-800 dark:text-neutral-200 max-w-2xl mx-auto leading-relaxed font-normal">
          The ultimate <strong class="text-neutral-950 dark:text-white font-bold">image to pdf maker</strong>. Convert JPG to PDF, PNG, WebP, and HEIC images into standardized PDF documents. Target exact file sizes like <strong class="text-neutral-950 dark:text-white font-bold">image to pdf 100kb</strong> or <strong class="text-neutral-950 dark:text-white font-bold">200kb</strong>, customize margins and orientation, and merge PDF files—completely private in your browser.
        </p>
      </div>

      <!-- Live Interactive Converter Area -->
      <div id="converter-section" class="mt-8 sm:mt-12 scroll-mt-24">
        <ImageToPdfConverter client:load />
      </div>

      <!-- Key Trust Proof Points -->
      <div class="mt-8 sm:mt-10 pt-6 sm:pt-8 border-t border-neutral-300/80 dark:border-neutral-800 grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 text-center text-xs text-neutral-900 dark:text-neutral-100">
        <div class="flex items-center justify-center gap-1.5 sm:gap-2 p-2.5 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-300/80 dark:border-neutral-800 shadow-2xs">
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span class="font-bold text-neutral-950 dark:text-neutral-50">100% Client-Side Privacy</span>
        </div>
        <div class="flex items-center justify-center gap-1.5 sm:gap-2 p-2.5 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-300/80 dark:border-neutral-800 shadow-2xs">
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span class="font-bold text-neutral-950 dark:text-neutral-50">Target 100KB &amp; 200KB</span>
        </div>
        <div class="flex items-center justify-center gap-1.5 sm:gap-2 p-2.5 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-300/80 dark:border-neutral-800 shadow-2xs">
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span class="font-bold text-neutral-950 dark:text-neutral-50">Zero Cloud Storage</span>
        </div>
        <div class="flex items-center justify-center gap-1.5 sm:gap-2 p-2.5 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-300/80 dark:border-neutral-800 shadow-2xs">
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span class="font-bold text-neutral-950 dark:text-neutral-50">No Account or Ads</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Popular / Featured Tools Section -->
  <section class="py-10 sm:py-12 max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-6 gap-2">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-950 dark:text-white">
          Popular Document Tools
        </h2>
        <p class="text-xs sm:text-sm text-neutral-700 dark:text-neutral-300 mt-1 font-medium">
          Fast, private tools for JPG to PDF, merge PDF, split PDF, and document optimization.
        </p>
      </div>
      <a href="#all-tools" class="text-xs font-bold text-neutral-900 dark:text-neutral-100 hover:text-blue-600 dark:hover:text-blue-400 flex items-center gap-1 transition-colors">
        View all 20+ tools ↓
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {POPULAR_TOOLS.slice(0, 4).map(tool => (
        <ToolCard tool={tool} />
      ))}
    </div>
  </section>

  <!-- All 5 PDF Tool Categories -->
  <div id="all-tools" class="max-w-7xl mx-auto px-4 sm:px-6 py-6 space-y-10 sm:space-y-12">
    <div class="text-center max-w-xl mx-auto pt-4 sm:pt-6">
      <span class="text-xs font-mono px-3 py-1 rounded-full bg-white dark:bg-neutral-800 text-neutral-900 dark:text-neutral-100 border border-neutral-300 dark:border-neutral-700 font-bold shadow-2xs">
        Tool Directory
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-neutral-950 dark:text-white mt-3">
        Complete PDF Suite
      </h2>
      <p class="mt-2 text-xs sm:text-sm text-neutral-700 dark:text-neutral-300 font-medium leading-relaxed">
        Categorized browser tools for converting image to PDF, organizing, resizing, and editing documents.
      </p>
    </div>

    <!-- Category 1: Organize PDF -->
    <CategorySection category={CATEGORIES[0]} />

    <!-- Category 2: Optimize PDF -->
    <CategorySection category={CATEGORIES[1]} />

    <!-- Category 3: Convert to PDF -->
    <CategorySection category={CATEGORIES[2]} />

    <!-- Category 4: Convert from PDF -->
    <CategorySection category={CATEGORIES[3]} />

    <!-- Category 5: Edit PDF -->
    <CategorySection category={CATEGORIES[4]} />
  </div>

  <!-- Privacy Comparison / Why We Are Better than iLovePDF -->
  <PrivacyBanner />

  <!-- Comprehensive 600+ Word SEO Content Section -->
  <SeoContent />

  <!-- Company, Policies & Direct Trust Hub -->
  <CompanyHubSection />

  <!-- FAQ Section with Rich Schema Integration -->
  <FAQSection />
</Layout>
