---
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';
import { TOOLS } from '../data/tools';

interface Props {
  error?: unknown;
}

const { error } = Astro.props;

const pageTitle = "500: Server & Application Error — Image To Pdf";
const pageDescription = "An unexpected error occurred while processing your request. All document conversions run 100% client-side, so your files remain private and secure on your device.";
const canonicalUrl = "https://onlineimagetopdf.com/500";

// Extract safe error info
const isDev = import.meta.env.DEV;
const errorMessage = error instanceof Error 
  ? error.message 
  : (typeof error === 'string' ? error : null);
const errorStack = isDev && error instanceof Error ? error.stack : null;

// Featured fallback tools
const fallbackTools = TOOLS.filter(
  (t) => t.isFunctional && ['image-to-pdf', 'jpg-to-pdf', 'merge-pdf', 'split-pdf'].includes(t.slug)
);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  robots="noindex, nofollow"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12 md:py-16">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs text-neutral-600 dark:text-neutral-400 font-mono">
      <a href="/" class="hover:text-neutral-950 dark:hover:text-white transition-colors">Home</a>
      <span>/</span>
      <span class="text-neutral-900 dark:text-neutral-200 font-semibold" aria-current="page">500 Error</span>
    </nav>

    <!-- Main 500 Hero Card -->
    <div class="relative overflow-hidden rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-950 p-6 sm:p-10 md:p-14 shadow-xs text-center">
      <!-- Decorative Background Grid -->
      <div class="absolute inset-0 bg-grid-pattern opacity-40 pointer-events-none" aria-hidden="true"></div>

      <!-- Ambient Red/Crimson Warning Glow -->
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-rose-500/10 dark:bg-rose-500/5 blur-3xl rounded-full pointer-events-none" aria-hidden="true"></div>

      <div class="relative z-10 max-w-2xl mx-auto">
        <!-- Status Pill Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-rose-100 dark:bg-rose-500/10 text-rose-900 dark:text-rose-300 border border-rose-300 dark:border-rose-500/20 text-xs font-mono font-bold mb-6">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-500"></span>
          </span>
          <span>HTTP 500 • Internal System Error</span>
        </div>

        <!-- Big 500 Glyph & Graphic -->
        <div class="flex items-center justify-center gap-3 sm:gap-4 my-2 select-none">
          <span class="font-mono text-7xl sm:text-8xl md:text-9xl font-black tracking-tighter text-neutral-900 dark:text-white leading-none">
            5
          </span>
          <div class="w-16 h-16 sm:w-20 sm:h-20 md:w-24 md:h-24 rounded-2xl bg-neutral-100 dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-800 flex items-center justify-center shadow-inner text-rose-600 dark:text-rose-400">
            <svg class="w-8 h-8 sm:w-10 sm:h-10 md:w-12 md:h-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect>
              <rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect>
              <line x1="6" y1="6" x2="6.01" y2="6"></line>
              <line x1="6" y1="18" x2="6.01" y2="18"></line>
              <line x1="10" y1="6" x2="10.01" y2="6"></line>
              <line x1="10" y1="18" x2="10.01" y2="18"></line>
            </svg>
          </div>
          <span class="font-mono text-7xl sm:text-8xl md:text-9xl font-black tracking-tighter text-neutral-900 dark:text-white leading-none">
            0
          </span>
        </div>

        <!-- Headings & Text -->
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-neutral-950 dark:text-white mt-4">
          Unexpected application error
        </h1>
        <p class="mt-3 text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-lg mx-auto">
          An unexpected issue prevented this page from completing your request. A quick browser reload often resolves temporary network or memory glitches.
        </p>

        <!-- Primary Action Buttons -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <button
            type="button"
            id="reload-page-btn"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-neutral-950 dark:bg-white text-white dark:text-neutral-950 font-bold text-xs sm:text-sm shadow-xs hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-all hover:scale-[1.02] cursor-pointer"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path>
              <path d="M21 3v5h-5"></path>
            </svg>
            <span>Reload Page</span>
          </button>

          <a
            href="/"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 text-neutral-900 dark:text-neutral-100 font-bold text-xs sm:text-sm hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-all"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>Return to Homepage</span>
          </a>

          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white text-xs sm:text-sm font-semibold transition-colors"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>Report Issue</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Zero-Upload Privacy Guarantee Reassurance Box -->
    <div class="mt-10 p-6 rounded-2xl border border-emerald-300/70 dark:border-emerald-500/20 bg-emerald-50/50 dark:bg-emerald-950/20 flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-500/20 border border-emerald-300 dark:border-emerald-500/30 flex items-center justify-center text-emerald-800 dark:text-emerald-300 shrink-0">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
      </div>
      <div class="flex-1">
        <h2 class="text-sm sm:text-base font-bold text-emerald-950 dark:text-emerald-200">
          Your Personal Data &amp; Documents Are 100% Safe
        </h2>
        <p class="text-xs sm:text-sm text-emerald-800 dark:text-emerald-400/90 mt-0.5 leading-relaxed">
          OnlineImageToPdf executes PDF rendering and conversions locally inside your browser sandbox via WebAssembly and HTML5 Canvas. Because no documents or files are transmitted to our servers, this error did not expose or compromise any user files.
        </p>
      </div>
    </div>

    <!-- Diagnostics / Technical Context (shown if error prop exists or in dev) -->
    {errorMessage && (
      <div class="mt-8 p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-neutral-900 text-neutral-100 dark:bg-neutral-950 font-mono text-xs">
        <div class="flex items-center justify-between pb-3 border-b border-neutral-800 mb-3">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500 inline-block"></span>
            <span class="font-bold text-neutral-200 text-xs uppercase tracking-wider">Error Details</span>
          </div>
          <button
            type="button"
            id="copy-error-btn"
            class="text-[11px] px-2.5 py-1 rounded-md bg-neutral-800 hover:bg-neutral-700 text-neutral-300 transition-colors cursor-pointer"
          >
            Copy Diagnostics
          </button>
        </div>
        <p id="error-message-text" class="text-rose-400 break-all font-mono leading-relaxed">
          {errorMessage}
        </p>
        {errorStack && (
          <pre class="mt-3 pt-3 border-t border-neutral-800 text-[11px] text-neutral-400 overflow-x-auto whitespace-pre-wrap max-h-48 leading-relaxed">
            {errorStack}
          </pre>
        )}
      </div>
    )}

    <!-- Troubleshooting Steps Grid -->
    <div class="mt-10">
      <h2 class="text-base sm:text-lg font-bold text-neutral-950 dark:text-white mb-4">
        Recommended Troubleshooting Steps
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 text-xs">
        <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-2xs">
          <div class="w-7 h-7 rounded-lg bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 flex items-center justify-center font-mono font-bold text-neutral-800 dark:text-neutral-200 mb-2.5">
            1
          </div>
          <h3 class="font-bold text-neutral-950 dark:text-white text-xs mb-1">
            Hard Refresh Browser
          </h3>
          <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Press <kbd class="px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 font-mono text-[10px]">Ctrl + F5</kbd> (Windows) or <kbd class="px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 font-mono text-[10px]">Cmd + Shift + R</kbd> (Mac) to clear cached scripts.
          </p>
        </div>

        <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-2xs">
          <div class="w-7 h-7 rounded-lg bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 flex items-center justify-center font-mono font-bold text-neutral-800 dark:text-neutral-200 mb-2.5">
            2
          </div>
          <h3 class="font-bold text-neutral-950 dark:text-white text-xs mb-1">
            Check Script Blockers
          </h3>
          <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Aggressive browser ad-blockers or security extensions can sometimes block local WebAssembly workers. Try whitelisting this site.
          </p>
        </div>

        <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-2xs">
          <div class="w-7 h-7 rounded-lg bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 flex items-center justify-center font-mono font-bold text-neutral-800 dark:text-neutral-200 mb-2.5">
            3
          </div>
          <h3 class="font-bold text-neutral-950 dark:text-white text-xs mb-1">
            Reduce Batch File Count
          </h3>
          <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Converting 50+ very high-resolution raw camera photos in a single batch can test mobile RAM limits. Try converting in smaller batches.
          </p>
        </div>

        <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-2xs">
          <div class="w-7 h-7 rounded-lg bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 flex items-center justify-center font-mono font-bold text-neutral-800 dark:text-neutral-200 mb-2.5">
            4
          </div>
          <h3 class="font-bold text-neutral-950 dark:text-white text-xs mb-1">
            Contact Support
          </h3>
          <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed">
            If this issue persists, please <a href="/contact" class="underline hover:text-blue-600 dark:hover:text-blue-400 font-semibold">notify our team</a> with the details and we'll fix it promptly.
          </p>
        </div>
      </div>
    </div>

    <!-- Alternative Tools Fallback Grid -->
    <div class="mt-12">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-neutral-950 dark:text-white">
            Ready-to-Use PDF Converters
          </h2>
          <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400">
            Continue working with one of our fully operational browser tools.
          </p>
        </div>
        <a
          href="/"
          class="text-xs font-semibold text-neutral-900 dark:text-neutral-200 hover:text-blue-600 dark:hover:text-blue-400 transition-colors inline-flex items-center gap-1"
        >
          <span>Main Converter</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        {fallbackTools.map((tool) => (
          <ToolCard tool={tool} />
        ))}
      </div>
    </div>
  </div>

  <script is:inline>
    const reloadBtn = document.getElementById('reload-page-btn');
    if (reloadBtn) {
      reloadBtn.addEventListener('click', function () {
        window.location.reload();
      });
    }

    const copyBtn = document.getElementById('copy-error-btn');
    const errorText = document.getElementById('error-message-text');
    if (copyBtn && errorText) {
      copyBtn.addEventListener('click', function () {
        navigator.clipboard.writeText(errorText.textContent.trim()).then(function () {
          const originalText = copyBtn.textContent;
          copyBtn.textContent = 'Copied!';
          setTimeout(function () {
            copyBtn.textContent = originalText;
          }, 2000);
        });
      });
    }
  </script>
</Layout>
