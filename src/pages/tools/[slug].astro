---
import Layout from '../../layouts/Layout.astro';
import { TOOLS, getToolBySlug, getToolsByCategory } from '../../data/tools';
import ImageToPdfConverter from '../../components/converter/ImageToPdfConverter';
import MergePdfTool from '../../components/tools/MergePdfTool';
import SplitPdfTool from '../../components/tools/SplitPdfTool';
import RotatePdfTool from '../../components/tools/RotatePdfTool';
import ComingSoonTool from '../../components/tools/ComingSoonTool';
import ToolCard from '../../components/ToolCard.astro';

export function getStaticPaths() {
  return TOOLS.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const relatedTools = getToolsByCategory(tool.category).filter((t) => t.id !== tool.id).slice(0, 3);

const isImageConverter = [
  'image-to-pdf',
  'jpg-to-pdf',
  'png-to-pdf',
  'webp-to-pdf',
  'heic-to-pdf',
  'multiple-images-to-one-pdf',
].includes(tool.slug);

const isMerge = tool.slug === 'merge-pdf';
const isSplit = tool.slug === 'split-pdf';
const isRotate = tool.slug === 'rotate-pdf-pages' || tool.slug === 'rotate-pages';
---

<Layout
  title={`${tool.name} — Free, Fast & 100% Client-Side Private | Image To Pdf`}
  description={`${tool.description} Fast, secure, zero server uploads.`}
  canonicalUrl={`https://onlineimagetopdf.com/tools/${tool.slug}`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10 md:py-12">
    <!-- Breadcrumb with wrapping for mobile -->
    <nav class="flex flex-wrap items-center gap-2 text-xs text-neutral-600 dark:text-neutral-400 mb-6 font-mono font-medium">
      <a href="/" class="hover:text-neutral-950 dark:hover:text-white transition-colors">Home</a>
      <span>/</span>
      <a href={`/#tools-${tool.category}`} class="capitalize hover:text-neutral-950 dark:hover:text-white transition-colors">
        {tool.category.replace(/-/g, ' ')}
      </a>
      <span>/</span>
      <span class="text-neutral-950 dark:text-white font-bold">{tool.name}</span>
    </nav>

    <!-- Header Section -->
    <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 border border-neutral-200 dark:border-neutral-700 text-xs font-mono font-semibold mb-3">
        <span>{tool.isFunctional ? '● Active Browser Tool' : '○ Roadmap Development'}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-neutral-950 dark:text-white">
        {tool.name}
      </h1>
      <p class="mt-3 text-sm sm:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed max-w-lg mx-auto">
        {tool.description}
      </p>
    </div>

    <!-- Tool Interactive Viewport -->
    <div class="mb-14 sm:mb-16">
      {isImageConverter && (
        <ImageToPdfConverter client:load initialToolName={tool.name} />
      )}

      {isMerge && (
        <MergePdfTool client:load />
      )}

      {isSplit && (
        <SplitPdfTool client:load />
      )}

      {isRotate && (
        <RotatePdfTool client:load />
      )}

      {!isImageConverter && !isMerge && !isSplit && !isRotate && (
        <ComingSoonTool client:load tool={tool} />
      )}
    </div>

    <!-- Related Category Tools -->
    {relatedTools.length > 0 && (
      <div class="pt-10 sm:pt-12 border-t border-neutral-200 dark:border-neutral-800">
        <h3 class="text-base sm:text-lg font-bold text-neutral-950 dark:text-white mb-4">
          Related Tools in this Category
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {relatedTools.map((t) => (
            <ToolCard tool={t} />
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>
