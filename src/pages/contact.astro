---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Contact Us — Support, Inquiries & Feedback | Image To Pdf";
const pageDescription = "Contact the OnlineImageToPdf.com team. Reach out for technical support, feature requests, bug reports, and document conversion assistance. Fast sub-24h response.";
const canonicalUrl = "https://onlineimagetopdf.com/contact";

const contactSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": pageTitle,
    "url": canonicalUrl,
    "description": pageDescription,
    "mainEntity": {
      "@type": "Organization",
      "name": "Image To Pdf",
      "url": "https://onlineimagetopdf.com",
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "email": "support@onlineimagetopdf.com",
          "contactType": "Customer Support",
          "availableLanguage": ["English"]
        },
        {
          "@type": "ContactPoint",
          "email": "privacy@onlineimagetopdf.com",
          "contactType": "Privacy Inquiries",
          "availableLanguage": ["English"]
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://onlineimagetopdf.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Contact Us",
        "item": canonicalUrl
      }
    ]
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  schema={contactSchemas}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12 md:py-16">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-xs text-neutral-600 dark:text-neutral-400 font-mono">
      <a href="/" class="hover:text-neutral-950 dark:hover:text-white transition-colors">Home</a>
      <span>/</span>
      <span class="text-neutral-900 dark:text-neutral-200 font-semibold" aria-current="page">Contact Us</span>
    </nav>

    <!-- Page Header -->
    <div class="mb-10 text-center max-w-2xl mx-auto">
      <span class="text-xs font-mono px-3.5 py-1 rounded-full bg-blue-100 dark:bg-blue-500/10 text-blue-800 dark:text-blue-300 border border-blue-300 dark:border-blue-500/20 font-bold inline-flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-blue-500"></span>
        Direct Support &amp; Feedback
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-neutral-950 dark:text-white mt-3">
        Get in Touch With Us
      </h1>
      <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 font-medium mt-2 leading-relaxed">
        Have feedback, discovered a bug, or want to suggest a new PDF tool? We read every inquiry and typically reply within 24 hours.
      </p>
    </div>

    <!-- Main Content: Two Columns -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
      <!-- Left Column: Direct Inquiries & FAQ Shortcuts -->
      <div class="lg:col-span-5 space-y-6">
        <!-- Contact Cards -->
        <div class="p-6 rounded-2xl bg-neutral-50 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-xs space-y-5">
          <h2 class="text-base font-bold text-neutral-950 dark:text-white flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            Direct Channels
          </h2>

          <div class="space-y-4 text-xs sm:text-sm">
            <div>
              <p class="font-semibold text-neutral-900 dark:text-neutral-100">Technical Support &amp; Bugs</p>
              <a href="mailto:support@onlineimagetopdf.com" class="text-blue-600 dark:text-blue-400 hover:underline font-mono">
                support@onlineimagetopdf.com
              </a>
              <p class="text-[11px] text-neutral-500 mt-0.5">Issues with image loading, conversion errors, or browser bugs.</p>
            </div>

            <div class="pt-3 border-t border-neutral-200 dark:border-neutral-800">
              <p class="font-semibold text-neutral-900 dark:text-neutral-100">Privacy &amp; Compliance</p>
              <a href="mailto:privacy@onlineimagetopdf.com" class="text-blue-600 dark:text-blue-400 hover:underline font-mono">
                privacy@onlineimagetopdf.com
              </a>
              <p class="text-[11px] text-neutral-500 mt-0.5">Questions regarding our client-side zero-upload guarantee.</p>
            </div>

            <div class="pt-3 border-t border-neutral-200 dark:border-neutral-800">
              <p class="font-semibold text-neutral-900 dark:text-neutral-100">Feature Requests &amp; Ideas</p>
              <a href="mailto:feedback@onlineimagetopdf.com" class="text-blue-600 dark:text-blue-400 hover:underline font-mono">
                feedback@onlineimagetopdf.com
              </a>
              <p class="text-[11px] text-neutral-500 mt-0.5">Suggest new image formats, PDF optimization tools, or UI improvements.</p>
            </div>
          </div>
        </div>

        <!-- SLA Response Promise Card -->
        <div class="p-5 rounded-2xl bg-emerald-50 dark:bg-emerald-950/20 border border-emerald-200 dark:border-emerald-800/60 flex items-start gap-3.5">
          <div class="w-8 h-8 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 font-bold">
            ✓
          </div>
          <div>
            <h3 class="text-xs sm:text-sm font-bold text-neutral-950 dark:text-white">Sub-24h Response Guarantee</h3>
            <p class="mt-1 text-xs text-neutral-700 dark:text-neutral-300 leading-relaxed">
              We respond to all genuine technical requests within one business day. Because we maintain zero server databases of your files, our support focus is 100% on browser performance and tool perfection.
            </p>
          </div>
        </div>

        <!-- Quick Help Card -->
        <div class="p-5 rounded-2xl bg-neutral-50 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-xs">
          <h3 class="font-bold text-neutral-950 dark:text-white mb-2">Looking for Instant Answers?</h3>
          <p class="text-neutral-600 dark:text-neutral-400 mb-3">Check out our frequently asked questions or technical specifications:</p>
          <div class="space-y-2 font-medium">
            <a href="/#faq-section" class="block text-blue-600 dark:text-blue-400 hover:underline">→ Browse Conversion FAQ</a>
            <a href="/about" class="block text-blue-600 dark:text-blue-400 hover:underline">→ How Client-Side Processing Works</a>
            <a href="/privacy" class="block text-blue-600 dark:text-blue-400 hover:underline">→ Read our Privacy Guarantee</a>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Contact Form -->
      <div class="lg:col-span-7">
        <div class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-xs">
          <h2 class="text-lg font-bold text-neutral-950 dark:text-white mb-1.5">
            Send Us a Message
          </h2>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 mb-6">
            Fill out the form below. We'll get back to your email address promptly.
          </p>

          <form id="contact-form" class="space-y-4">
            <div>
              <label for="contact-name" class="block text-xs font-semibold text-neutral-800 dark:text-neutral-200 mb-1.5">
                Your Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="e.g. Jane Doe"
                class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-300 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-950 text-neutral-950 dark:text-white text-xs sm:text-sm focus:outline-hidden focus:border-blue-500 transition-colors"
              />
            </div>

            <div>
              <label for="contact-email" class="block text-xs font-semibold text-neutral-800 dark:text-neutral-200 mb-1.5">
                Email Address <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="you@example.com"
                class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-300 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-950 text-neutral-950 dark:text-white text-xs sm:text-sm focus:outline-hidden focus:border-blue-500 transition-colors"
              />
            </div>

            <div>
              <label for="contact-topic" class="block text-xs font-semibold text-neutral-800 dark:text-neutral-200 mb-1.5">
                Topic / Category <span class="text-red-500">*</span>
              </label>
              <select
                id="contact-topic"
                name="topic"
                required
                class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-300 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-950 text-neutral-950 dark:text-white text-xs sm:text-sm focus:outline-hidden focus:border-blue-500 transition-colors"
              >
                <option value="technical-support">Technical Support / Bug Report</option>
                <option value="feature-request">Feature Request / Tool Suggestion</option>
                <option value="feedback">User Feedback / Review</option>
                <option value="privacy">Privacy &amp; Security Inquiry</option>
                <option value="other">Other Inquiries</option>
              </select>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-semibold text-neutral-800 dark:text-neutral-200 mb-1.5">
                Message <span class="text-red-500">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                required
                placeholder="Please describe your question, issue, or suggestion in detail..."
                class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-300 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-950 text-neutral-950 dark:text-white text-xs sm:text-sm focus:outline-hidden focus:border-blue-500 transition-colors resize-y"
              ></textarea>
            </div>

            <button
              type="submit"
              id="contact-submit"
              class="w-full py-3 px-6 rounded-xl bg-neutral-950 dark:bg-white text-white dark:text-neutral-950 text-xs sm:text-sm font-semibold hover:bg-neutral-800 dark:hover:bg-neutral-100 transition-all cursor-pointer shadow-xs active:scale-[0.99] flex items-center justify-center gap-2"
            >
              <span>Send Message</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>
          </form>

          <!-- Success notification (client-side feedback) -->
          <div id="contact-success" class="hidden mt-4 p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-300 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs sm:text-sm">
            <div class="flex items-center gap-2 font-bold mb-1">
              <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              Message Received!
            </div>
            <p>Thank you for reaching out. Our engineering team has received your message and will review it shortly. Expect a response to your email address within 24 hours.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Navigation Footnote -->
    <div class="mt-12 pt-6 border-t border-neutral-200 dark:border-neutral-800 flex flex-wrap items-center justify-between gap-4">
      <a href="/" class="text-blue-600 dark:text-blue-400 hover:underline font-bold text-xs inline-flex items-center gap-1">
        ← Back to converter tools
      </a>
      <div class="flex items-center gap-4 text-xs text-neutral-600 dark:text-neutral-400">
        <a href="/about" class="hover:text-neutral-950 dark:hover:text-white underline">About Us</a>
        <span>•</span>
        <a href="/privacy" class="hover:text-neutral-950 dark:hover:text-white underline">Privacy Policy</a>
        <span>•</span>
        <a href="/terms" class="hover:text-neutral-950 dark:hover:text-white underline">Terms &amp; Conditions</a>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  const form = document.getElementById('contact-form');
  const successBox = document.getElementById('contact-success');
  const submitBtn = document.getElementById('contact-submit');

  if (form && successBox && submitBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const originalText = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>Sending...</span>';

      // Simulate instantaneous processing with client feedback
      setTimeout(() => {
        form.reset();
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
        successBox.classList.remove('hidden');
        successBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }, 600);
    });
  }
</script>
