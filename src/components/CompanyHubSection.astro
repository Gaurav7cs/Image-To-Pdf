---
interface HubCard {
  title: string;
  badge: string;
  badgeColor: string;
  description: string;
  href: string;
  ctaText: string;
  icon: string;
}

const HUB_CARDS: HubCard[] = [
  {
    title: "About Us",
    badge: "Architecture & Mission",
    badgeColor: "bg-blue-100 dark:bg-blue-500/10 text-blue-800 dark:text-blue-300 border-blue-200 dark:border-blue-500/30",
    description: "Discover why we created OnlineImageToPdf. We replaced insecure remote cloud uploads with browser-native WebAssembly compilation that executes entirely in device memory.",
    href: "/about",
    ctaText: "Explore Our Story",
    icon: "layers"
  },
  {
    title: "Privacy Policy",
    badge: "Zero Server Uploads",
    badgeColor: "bg-emerald-100 dark:bg-emerald-500/10 text-emerald-800 dark:text-emerald-300 border-emerald-200 dark:border-emerald-500/30",
    description: "Our strict zero-upload guarantee: 0 bytes leave your machine. Read how our client sandbox ensures complete GDPR, CCPA, and COPPA privacy compliance.",
    href: "/privacy",
    ctaText: "Read Privacy Policy",
    icon: "shield"
  },
  {
    title: "Terms & Conditions",
    badge: "100% Your Ownership",
    badgeColor: "bg-purple-100 dark:bg-purple-500/10 text-purple-800 dark:text-purple-300 border-purple-200 dark:border-purple-500/30",
    description: "Clear, transparent usage terms for our free document toolkit. You retain 100% copyright and ownership of all images and PDF documents converted.",
    href: "/terms",
    ctaText: "View Terms of Service",
    icon: "file-text"
  },
  {
    title: "Contact Us",
    badge: "Sub-24h Response",
    badgeColor: "bg-amber-100 dark:bg-amber-500/10 text-amber-800 dark:text-amber-300 border-amber-200 dark:border-amber-500/30",
    description: "Encountered a conversion issue, discovered a bug, or want to suggest a new tool? Contact our engineering team directly via form or email.",
    href: "/contact",
    ctaText: "Get in Touch With Us",
    icon: "mail"
  }
];
---

<section class="py-14 sm:py-20 border-t border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-950/40 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
      <span class="inline-flex items-center gap-1.5 text-xs font-mono px-3.5 py-1 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 border border-neutral-200 dark:border-neutral-700 font-semibold">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Trust, Policies &amp; Company
      </span>
      <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-neutral-950 dark:text-white mt-3">
        Built on Privacy, Transparency &amp; Open Support
      </h2>
      <p class="mt-3 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
        We believe everyday document tools should be honest, completely free, and respectful of your data. Explore our architecture, legal commitments, and direct contact channels below.
      </p>
    </div>

    <!-- 4 Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      {HUB_CARDS.map((card) => (
        <div class="group flex flex-col justify-between p-6 rounded-2xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 hover:border-neutral-400 dark:hover:border-neutral-600 shadow-xs transition-all hover:shadow-md">
          <div>
            <!-- Badge & Icon -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class={`text-[11px] font-mono font-bold px-2.5 py-0.5 rounded-full border ${card.badgeColor}`}>
                {card.badge}
              </span>
              <div class="w-8 h-8 rounded-lg bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-neutral-700 dark:text-neutral-300">
                {card.icon === 'layers' && (
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                    <polyline points="2 17 12 22 22 17"></polyline>
                    <polyline points="2 12 12 17 22 12"></polyline>
                  </svg>
                )}
                {card.icon === 'shield' && (
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
                )}
                {card.icon === 'file-text' && (
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                  </svg>
                )}
                {card.icon === 'mail' && (
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                  </svg>
                )}
              </div>
            </div>

            <!-- Title -->
            <h3 class="text-base font-bold text-neutral-950 dark:text-white mb-2">
              {card.title}
            </h3>

            <!-- Description -->
            <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed mb-6">
              {card.description}
            </p>
          </div>

          <!-- Action Link -->
          <div class="pt-4 border-t border-neutral-100 dark:border-neutral-800">
            <a
              href={card.href}
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-neutral-950 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors"
            >
              <span>{card.ctaText}</span>
              <span class="transform group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
