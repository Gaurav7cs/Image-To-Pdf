---
import { FAQS } from '../data/faqs';

interface Props {
  includeSchema?: boolean;
}

const { includeSchema = true } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": FAQS.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

{includeSchema && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema, null, 2)} />
)}

<section id="faq-section" class="py-14 sm:py-20 max-w-4xl mx-auto px-4 sm:px-6">
  <div class="text-center mb-10 sm:mb-12">
    <span class="inline-flex items-center gap-1.5 text-xs font-mono px-3.5 py-1 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 border border-neutral-200 dark:border-neutral-700 font-semibold">
      <span class="w-2 h-2 rounded-full bg-blue-500"></span>
      Frequently Asked Questions
    </span>
    <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-neutral-950 dark:text-white mt-3">
      Everything You Need to Know
    </h2>
    <p class="mt-2 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 max-w-xl mx-auto">
      Answers to the most common questions about converting images to PDF, hitting 200KB file size targets, and managing documents securely.
    </p>
  </div>

  <div class="space-y-3.5">
    {FAQS.map((faq, index) => (
      <details class="group bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-2xl overflow-hidden shadow-xs hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors">
        <summary class="flex items-center justify-between p-4 sm:p-5 text-sm sm:text-base font-bold text-neutral-950 dark:text-neutral-100 cursor-pointer select-none list-none min-h-[56px] group-open:border-b group-open:border-neutral-200 dark:group-open:border-neutral-800 transition-colors">
          <div class="flex items-center gap-3 pr-2 text-left">
            <span class="text-xs font-mono font-semibold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/60 px-2 py-0.5 rounded border border-blue-200/50 dark:border-blue-900/40 shrink-0">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span>{faq.question}</span>
          </div>
          <svg class="w-4 h-4 text-neutral-500 dark:text-neutral-400 group-open:rotate-180 transition-transform shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="faq-content p-4 sm:p-6 text-xs sm:text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed bg-neutral-50/60 dark:bg-neutral-950/50" set:html={faq.answer} />
      </details>
    ))}
  </div>
</section>

<style>
  .faq-content :global(p) {
    margin-bottom: 0.75rem;
  }
  .faq-content :global(p:last-child) {
    margin-bottom: 0;
  }
  .faq-content :global(ol) {
    list-style-type: decimal;
    padding-left: 1.25rem;
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .faq-content :global(ul) {
    list-style-type: disc;
    padding-left: 1.25rem;
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .faq-content :global(li) {
    margin-bottom: 0.4rem;
    line-height: 1.6;
  }
  .faq-content :global(li:last-child) {
    margin-bottom: 0;
  }
  .faq-content :global(a) {
    color: #2563eb;
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 500;
  }
  .faq-content :global(a:hover) {
    color: #1d4ed8;
  }
  :global(.dark) .faq-content :global(a) {
    color: #60a5fa;
  }
  :global(.dark) .faq-content :global(a:hover) {
    color: #93c5fd;
  }
  .faq-content :global(strong) {
    font-weight: 600;
    color: #0a0a0a;
  }
  :global(.dark) .faq-content :global(strong) {
    color: #f5f5f5;
  }
</style>
