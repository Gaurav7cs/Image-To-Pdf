---
import { FAQS } from '../data/faqs';
---

<section id="faq-section" class="py-14 sm:py-16 max-w-4xl mx-auto px-4 sm:px-6">
  <div class="text-center mb-8 sm:mb-10">
    <span class="text-xs font-mono px-3 py-1 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 border border-neutral-200 dark:border-neutral-700 font-semibold">
      Frequently Asked Questions
    </span>
    <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-neutral-950 dark:text-white mt-3">
      Everything You Need to Know
    </h2>
    <p class="mt-2 text-xs sm:text-sm text-neutral-700 dark:text-neutral-300 max-w-lg mx-auto">
      Learn how client-side PDF document processing keeps your data 100% private.
    </p>
  </div>

  <div class="space-y-3">
    {FAQS.map((faq) => (
      <details class="group bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-2xl overflow-hidden shadow-xs transition-colors">
        <summary class="flex items-center justify-between p-4 sm:p-5 text-sm sm:text-base font-bold text-neutral-950 dark:text-neutral-100 cursor-pointer select-none list-none min-h-[52px] group-open:border-b group-open:border-neutral-200 dark:group-open:border-neutral-800">
          <span class="pr-2">{faq.question}</span>
          <svg class="w-4 h-4 text-neutral-600 dark:text-neutral-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="p-4 sm:p-5 text-xs sm:text-sm text-neutral-800 dark:text-neutral-200 leading-relaxed bg-neutral-50/70 dark:bg-neutral-950/60">
          {faq.answer}
        </div>
      </details>
    ))}
  </div>
</section>
