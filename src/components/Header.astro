---
import { CATEGORIES } from '../data/tools';
---

<header class="sticky top-0 z-50 w-full border-b border-neutral-200/90 dark:border-neutral-800 bg-white/95 dark:bg-black/95 backdrop-blur-md transition-colors shadow-2xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-2">
    <!-- Brand Logo -->
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2.5 group shrink-0">
        <div class="w-8 h-8 rounded-lg bg-neutral-950 dark:bg-white flex items-center justify-center text-white dark:text-neutral-950 font-bold text-base shadow-xs group-hover:scale-105 transition-transform">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-bold text-sm tracking-tight text-neutral-950 dark:text-white flex items-center gap-1.5">
            Image To Pdf
            <span class="text-[10px] px-1.5 py-0.2 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 border border-neutral-300/80 dark:border-neutral-700 font-mono font-semibold">v1.0</span>
          </span>
          <span class="text-[10px] text-neutral-600 dark:text-neutral-400 font-mono font-medium -mt-0.5">onlineimagetopdf.com</span>
        </div>
      </a>

      <!-- Desktop Nav (Hidden on Mobile/Tablet) -->
      <nav class="hidden lg:flex items-center gap-1 text-xs" aria-label="Main Navigation">
        <a href="/" class="px-3 py-1.5 rounded-full text-neutral-800 dark:text-neutral-200 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors font-bold">
          Home
        </a>
        <a href="/#tools-organize" class="px-3 py-1.5 rounded-full text-neutral-800 dark:text-neutral-200 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors font-semibold">
          Organize
        </a>
        <a href="/#tools-optimize" class="px-3 py-1.5 rounded-full text-neutral-800 dark:text-neutral-200 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors font-semibold">
          Optimize
        </a>
        <a href="/#tools-convert-to-pdf" class="px-3 py-1.5 rounded-full text-neutral-950 dark:text-white bg-neutral-100 dark:bg-neutral-900 font-bold border border-neutral-300 dark:border-neutral-700 shadow-2xs">
          Convert to PDF
        </a>
        <a href="/#tools-convert-from-pdf" class="px-3 py-1.5 rounded-full text-neutral-800 dark:text-neutral-200 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors font-semibold">
          Convert from PDF
        </a>
        <a href="/#tools-edit" class="px-2.5 py-1.5 rounded-full text-neutral-800 dark:text-neutral-200 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors font-semibold">
          Edit PDF
        </a>
        <a href="/about" class="px-2.5 py-1.5 rounded-full text-neutral-800 dark:text-neutral-200 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors font-semibold">
          About
        </a>
        <a href="/contact" class="px-2.5 py-1.5 rounded-full text-neutral-800 dark:text-neutral-200 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors font-semibold">
          Contact
        </a>
      </nav>
    </div>

    <!-- Right Utility Bar -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <!-- Privacy Badge (hidden on small mobile) -->
      <div class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-300 dark:border-emerald-500/30 text-emerald-900 dark:text-emerald-300 text-xs font-mono font-bold">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        Zero Server Uploads
      </div>

      <!-- Theme Switcher -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle theme"
        class="p-2 rounded-full border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-800 dark:text-neutral-200 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 shadow-2xs transition-colors cursor-pointer"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="w-4 h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Primary CTA button -->
      <a
        href="/#converter-section"
        class="hidden xs:inline-flex items-center justify-center px-3.5 sm:px-4 py-1.5 rounded-full bg-neutral-950 dark:bg-white text-white dark:text-neutral-950 text-xs font-bold hover:bg-neutral-800 dark:hover:bg-neutral-100 transition-all cursor-pointer shadow-xs active:scale-[0.98]"
      >
        Convert Images
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-button"
        type="button"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
        aria-controls="mobile-menu"
        class="lg:hidden p-2 rounded-lg border border-neutral-300 dark:border-neutral-800 text-neutral-800 dark:text-neutral-200 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors cursor-pointer"
      >
        <!-- Hamburger Bars Icon -->
        <svg id="icon-menu" class="w-5 h-5 block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
        <!-- Close X Icon -->
        <svg id="icon-close" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation Drawer -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-b border-neutral-300 dark:border-neutral-800 bg-white dark:bg-black px-4 py-4 space-y-4 max-h-[85vh] overflow-y-auto transition-all shadow-md"
  >
    <!-- Privacy indicator on mobile -->
    <div class="flex sm:hidden items-center justify-between p-2.5 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-300 dark:border-emerald-500/30 text-emerald-900 dark:text-emerald-300 text-xs font-mono font-bold">
      <span class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Zero Server Uploads
      </span>
      <span class="text-[11px] text-emerald-800 dark:text-emerald-400 font-bold">100% Local</span>
    </div>

    <!-- Quick Tool Shortcuts -->
    <div>
      <p class="text-[11px] font-mono font-bold uppercase tracking-wider text-neutral-600 dark:text-neutral-400 mb-2">
        Quick Tools
      </p>
      <div class="grid grid-cols-2 gap-2 text-xs">
        <a
          href="/tools/image-to-pdf"
          class="mobile-nav-link flex items-center gap-2 p-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-800 text-neutral-950 dark:text-white font-bold hover:border-neutral-400 transition-colors shadow-2xs"
        >
          <span class="w-2 h-2 rounded-full bg-blue-500"></span>
          Image to PDF
        </a>
        <a
          href="/tools/merge-pdf"
          class="mobile-nav-link flex items-center gap-2 p-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-800 text-neutral-950 dark:text-white font-bold hover:border-neutral-400 transition-colors shadow-2xs"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          Merge PDF
        </a>
        <a
          href="/tools/split-pdf"
          class="mobile-nav-link flex items-center gap-2 p-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-800 text-neutral-950 dark:text-white font-bold hover:border-neutral-400 transition-colors shadow-2xs"
        >
          <span class="w-2 h-2 rounded-full bg-purple-500"></span>
          Split PDF
        </a>
        <a
          href="/tools/rotate-pdf-pages"
          class="mobile-nav-link flex items-center gap-2 p-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-800 text-neutral-950 dark:text-white font-bold hover:border-neutral-400 transition-colors shadow-2xs"
        >
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          Rotate PDF
        </a>
      </div>
    </div>

    <!-- Category Links (Min 44px touch height) -->
    <div class="pt-2 border-t border-neutral-200 dark:border-neutral-800">
      <p class="text-[11px] font-mono font-bold uppercase tracking-wider text-neutral-600 dark:text-neutral-400 mb-1">
        Browse by Category
      </p>
      <nav class="space-y-1">
        <a
          href="/#tools-organize"
          class="mobile-nav-link flex items-center justify-between min-h-[44px] px-3 rounded-lg text-sm font-bold text-neutral-900 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-900"
        >
          <span>1. Organize PDF</span>
          <span class="text-xs text-neutral-600 dark:text-neutral-400 font-mono font-medium">5 tools →</span>
        </a>
        <a
          href="/#tools-optimize"
          class="mobile-nav-link flex items-center justify-between min-h-[44px] px-3 rounded-lg text-sm font-bold text-neutral-900 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-900"
        >
          <span>2. Optimize PDF</span>
          <span class="text-xs text-neutral-600 dark:text-neutral-400 font-mono font-medium">3 tools →</span>
        </a>
        <a
          href="/#tools-convert-to-pdf"
          class="mobile-nav-link flex items-center justify-between min-h-[44px] px-3 rounded-lg text-sm font-bold text-neutral-950 dark:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900"
        >
          <span class="text-blue-700 dark:text-blue-400 font-bold">3. Convert to PDF</span>
          <span class="text-xs text-neutral-600 dark:text-neutral-400 font-mono font-medium">7 tools →</span>
        </a>
        <a
          href="/#tools-convert-from-pdf"
          class="mobile-nav-link flex items-center justify-between min-h-[44px] px-3 rounded-lg text-sm font-bold text-neutral-900 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-900"
        >
          <span>4. Convert from PDF</span>
          <span class="text-xs text-neutral-600 dark:text-neutral-400 font-mono font-medium">3 tools →</span>
        </a>
        <a
          href="/#tools-edit"
          class="mobile-nav-link flex items-center justify-between min-h-[44px] px-3 rounded-lg text-sm font-bold text-neutral-900 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-900"
        >
          <span>5. Edit PDF</span>
          <span class="text-xs text-neutral-600 dark:text-neutral-400 font-mono font-medium">7 tools →</span>
        </a>
      </nav>
    </div>

    <!-- Company & Legal Navigation -->
    <div class="pt-3 border-t border-neutral-200 dark:border-neutral-800">
      <p class="text-[11px] font-mono font-bold uppercase tracking-wider text-neutral-600 dark:text-neutral-400 mb-2">
        Company &amp; Legal
      </p>
      <div class="grid grid-cols-2 gap-2 text-xs">
        <a
          href="/about"
          class="mobile-nav-link p-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-800 text-neutral-900 dark:text-neutral-200 hover:text-neutral-950 dark:hover:text-white font-bold"
        >
          About Us
        </a>
        <a
          href="/contact"
          class="mobile-nav-link p-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-800 text-neutral-900 dark:text-neutral-200 hover:text-neutral-950 dark:hover:text-white font-bold"
        >
          Contact Us
        </a>
        <a
          href="/privacy"
          class="mobile-nav-link p-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-800 text-neutral-900 dark:text-neutral-200 hover:text-neutral-950 dark:hover:text-white font-bold"
        >
          Privacy Policy
        </a>
        <a
          href="/terms"
          class="mobile-nav-link p-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-800 text-neutral-900 dark:text-neutral-200 hover:text-neutral-950 dark:hover:text-white font-bold"
        >
          Terms &amp; Conditions
        </a>
      </div>
    </div>

    <!-- Mobile Convert CTA -->
    <div class="pt-2">
      <a
        href="/#converter-section"
        class="mobile-nav-link w-full min-h-[44px] flex items-center justify-center gap-2 rounded-full bg-neutral-950 dark:bg-white text-white dark:text-neutral-950 text-xs font-bold hover:bg-neutral-800 dark:hover:bg-neutral-100 transition-all shadow-xs"
      >
        Launch Image to PDF Converter
      </a>
    </div>
  </div>
</header>

<script is:inline>
  // Theme Switcher Logic
  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  }

  // Mobile Menu Logic
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  if (menuButton && mobileMenu && iconMenu && iconClose) {
    const toggleMenu = () => {
      const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!isExpanded));
      if (isExpanded) {
        mobileMenu.classList.add('hidden');
        iconMenu.classList.remove('hidden');
        iconMenu.classList.add('block');
        iconClose.classList.remove('block');
        iconClose.classList.add('hidden');
      } else {
        mobileMenu.classList.remove('hidden');
        iconMenu.classList.remove('block');
        iconMenu.classList.add('hidden');
        iconClose.classList.remove('hidden');
        iconClose.classList.add('block');
      }
    };

    menuButton.addEventListener('click', toggleMenu);

    // Close menu when clicking on any mobile nav link
    const mobileLinks = mobileMenu.querySelectorAll('.mobile-nav-link');
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        menuButton.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.add('hidden');
        iconMenu.classList.remove('hidden');
        iconMenu.classList.add('block');
        iconClose.classList.remove('block');
        iconClose.classList.add('hidden');
      });
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') {
        toggleMenu();
      }
    });
  }
</script>
