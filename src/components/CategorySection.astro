---
import type { CategoryInfo } from '../data/tools';
import { getToolsByCategory } from '../data/tools';
import ToolCard from './ToolCard.astro';

interface Props {
  category: CategoryInfo;
}

const { category } = Astro.props;
const tools = getToolsByCategory(category.id);
---

<section id={`tools-${category.id}`} class="py-8 scroll-mt-20">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 pb-3 border-b border-neutral-200 dark:border-neutral-800 gap-2">
    <div>
      <div class="flex items-center gap-2">
        <h2 class="text-xl font-bold tracking-tight text-neutral-950 dark:text-white">
          {category.name}
        </h2>
        <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-700 font-semibold">
          {tools.length} Tools
        </span>
      </div>
      <p class="mt-1 text-xs sm:text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
        {category.description}
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-4">
    {tools.map(tool => (
      <ToolCard tool={tool} />
    ))}
  </div>
</section>
